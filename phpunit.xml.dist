<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="tests/bootstrap.php" colors="true" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <coverage>
    <report>
      <html outputDirectory="tests/log/report" lowUpperBound="40" highLowerBound="70"/>
    </report>
  </coverage>
  <testsuites>
    <testsuite name="PHPExif">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <logging>
    <testdoxHtml outputFile="tests/log/testdox.html"/>
  </logging>
  <source>
    <include>
      <directory suffix=".php">./lib</directory>
    </include>
    <exclude>
      <file>./autoload.php</file>
      <file>*Interface.php</file>
    </exclude>
  </source>
</phpunit>
